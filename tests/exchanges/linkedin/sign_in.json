[
  {
    "note": "the authorization code exchanged for a member token; LinkedIn Posts API (learn.microsoft.com/linkedin/marketing/community-management/shares/posts-api), OpenID Connect userinfo, and the OAuth 2.0 authorization code flow",
    "request": {
      "method": "POST",
      "url": "https://www.linkedin.com/oauth/v2/accessToken",
      "form": {
        "grant_type": "authorization_code",
        "code": "code-from-linkedin",
        "redirect_uri": "*",
        "client_id": "{HERALD_LINKEDIN_CLIENT_ID}",
        "client_secret": "{HERALD_LINKEDIN_CLIENT_SECRET}"
      }
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "json": {
        "access_token": "AQX-new-linkedin-token-0123456789",
        "expires_in": 5184000,
        "scope": "openid,profile,w_member_social",
        "token_type": "Bearer",
        "id_token": "eyJhbGciOiJSUzI1NiJ9.id"
      }
    }
  },
  {
    "note": "the member behind the token, from OpenID Connect userinfo; LinkedIn Posts API (learn.microsoft.com/linkedin/marketing/community-management/shares/posts-api), OpenID Connect userinfo, and the OAuth 2.0 authorization code flow",
    "request": {
      "method": "GET",
      "url": "https://api.linkedin.com/v2/userinfo",
      "headers": {
        "Authorization": "Bearer AQX-new-linkedin-token-0123456789"
      }
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "json": {
        "sub": "782bbtaQ",
        "name": "Ada Example",
        "given_name": "Ada",
        "family_name": "Example",
        "locale": {
          "country": "US",
          "language": "en"
        }
      }
    }
  }
]
